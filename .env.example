# Core LLM provider (required for online generation/evaluation)
REMOTE_URL=https://api.openai.com/v1/chat/completions
TOKEN=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEFAULT_CHATAGENT_MODEL=

# Embeddings (optional for offline smoke tests)
EMBED_REMOTE_URL=
EMBED_TOKEN=
DEFAULT_EMBED_ONLINE_MODEL=BAAI/bge-base-en-v1.5

# Multimodal and image generation (optional)
MULTIMODAL_API_URL=
MULTIMODAL_API_KEY=
MULTIMODAL_MODEL=
AI_IMAGE_API_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=

# Data services (optional)
OPENALEX_EMAIL=your-email@example.com
CRAWLER_BASE_URL=
FIG_RETRIEVE_URL=
FIG_RETRIEVE_TOKEN=

# Experiment configuration (point to a local, ignored JSON file)
SURVEYGRAPH_EXPERIMENT_CONFIG=experiments/configs/dashscope_models.local.json

# Optional frontend service
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=surveygraph
DB_USER=surveygraph
DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-value
APP_HOST=127.0.0.1
APP_PORT=8065
CORS_ORIGINS=http://127.0.0.1:8065
